import core/result::{Result}

fn is_alpha_num(u: u32) -> bool {
    if u >= 48 && u <= 57 { return true }   // 0-9
    if u >= 65 && u <= 90 { return true }   // A-Z
    if u >= 97 && u <= 122 { return true }  // a-z
    if u == 95 { return true }              // _
    return false
}

fn word_matches(view: str, expected: str) -> bool {
    if view.len() != expected.len() { return false }
    auto i# = 0:usize
    auto len = view.len()
    loop i < len {
        auto c = view.at(i).unwrap()
        auto e = expected.at(i).unwrap()
        auto c_upper# = c
        if c >= 97 && c <= 122 {
            c_upper = c - 32
        }
        if c_upper != e { return false }
        i += 1
    }
    return true
}

pub fn scan_sql_safety(sql: string) -> Result<bool, string> {
    auto view = sql.as_str()
    auto len = view.len()
    auto i# = 0:usize

    loop i < len {
        auto c = view.at(i).unwrap()

        // 1. Skip single-line comments (-- ...)
        if c == 45:u32 && i + 1:usize < len && view.at(i + 1:usize).unwrap() == 45:u32 {
            i += 2:usize
            loop i < len {
                auto ch = view.at(i).unwrap()
                i += 1
                if ch == 10:u32 || ch == 13:u32 { break }
            }
            continue
        }

        // 2. Skip multi-line comments (/* ... */)
        if c == 47:u32 && i + 1:usize < len && view.at(i + 1:usize).unwrap() == 42:u32 {
            i += 2:usize
            loop i < len {
                if view.at(i).unwrap() == 42:u32 && i + 1:usize < len && view.at(i + 1:usize).unwrap() == 47:u32 {
                    i += 2:usize
                    break
                }
                i += 1
            }
            continue
        }

        // 3. Skip single-quoted string literals ('...')
        if c == 39:u32 {
            i += 1
            loop i < len {
                auto ch = view.at(i).unwrap()
                if ch == 39:u32 {
                    if i + 1:usize < len && view.at(i + 1:usize).unwrap() == 39:u32 {
                        // Escaped quote ''
                        i += 2:usize
                        continue
                    }
                    i += 1
                    break
                }
                i += 1
            }
            continue
        }

        // 4. Skip double-quoted identifiers ("...")
        if c == 34:u32 {
            i += 1
            loop i < len {
                auto ch = view.at(i).unwrap()
                if ch == 34:u32 {
                    if i + 1:usize < len && view.at(i + 1:usize).unwrap() == 34:u32 {
                        // Escaped quote ""
                        i += 2:usize
                        continue
                    }
                    i += 1
                    break
                }
                i += 1
            }
            continue
        }

        // 5. Skip non-alphanumeric delimiters
        if !is_alpha_num(c) {
            i += 1
            continue
        }

        // 6. Extract identifier / keyword word
        auto start = i
        loop i < len {
            auto ch = view.at(i).unwrap()
            if !is_alpha_num(ch) { break }
            i += 1
        }

        auto word_view = view.substring(start, i)
        if word_matches(word_view, "BEGIN") || word_matches(word_view, "COMMIT") ||
           word_matches(word_view, "END") || word_matches(word_view, "ROLLBACK") ||
           word_matches(word_view, "SAVEPOINT") || word_matches(word_view, "RELEASE") ||
           word_matches(word_view, "VACUUM") {
            auto err# = string::from("migration SQL contains forbidden statement: '")
            err#.push_str(word_view)
            err#.push_str("'. Custom transaction control (BEGIN, COMMIT, END, ROLLBACK, SAVEPOINT, RELEASE) or VACUUM is not permitted inside migrations.")
            return Result<bool, string>::Err(cede err)
        }
    }

    return Result<bool, string>::Ok(true)
}
