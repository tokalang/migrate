import std/io::{println}
import official/sqlite::{Database}
import src/discovery::{MigrationFile, discover_migrations}
import src/ledger::{AppliedRecord, is_database_initialized, get_applied_records}

pub fn execute_verify(db_path: string, migrations_dir: string) -> i32 {
    auto disc_res = discover_migrations(migrations_dir.clone())
    if disc_res.is_err() {
        println("Error during migration discovery: {}", disc_res.unwrap_err())
        return 1
    }
    auto local_files = disc_res.unwrap()

    if !is_database_initialized(db_path.clone()) {
        println("Database '{}' is not initialized. 0 applied migrations verified.", db_path)
        return 0
    }

    auto db_res = Database::open(db_path.as_str())
    if db_res.is_err() {
        println("Error opening database '{}': {}", db_path, db_res.unwrap_err().message())
        return 1
    }
    auto db# = db_res.unwrap()
    auto rec_res = get_applied_records(db)
    db#.close()
    if rec_res.is_err() {
        println("Error reading migration ledger: {}", rec_res.unwrap_err())
        return 1
    }
    auto applied_records = rec_res.unwrap()

    if applied_records.len() == 0 {
        println("No migrations recorded in database '{}'. Verification PASSED.", db_path)
        return 0
    }

    auto has_error# = false
    auto verified_count# = 0:usize

    auto r_idx# = 0:usize
    loop r_idx < applied_records.len() {
        auto &rec = applied_records.get_ref(r_idx)
        auto found_local# = false
        auto local_sha# = string::from("")

        auto l_idx# = 0:usize
        loop l_idx < local_files.len() {
            auto &m = local_files.get_ref(l_idx)
            if m.id.as_str() == rec.id.as_str() {
                found_local = true
                local_sha = m.sha256.clone()
                break
            }
            l_idx += 1
        }

        if !found_local {
            println("VERIFY FAILURE: Migration '{}' is recorded in database but missing on disk!", rec.id)
            has_error = true
        } else {
            if local_sha.as_str() != rec.sha256.as_str() {
                println("VERIFY FAILURE: Migration '{}' checksum mismatch! (recorded: {}, local: {})",
                    rec.id, rec.sha256, local_sha)
                has_error = true
            } else {
                verified_count += 1
            }
        }
        r_idx += 1
    }

    if has_error {
        println("Migration verification FAILED.")
        return 1
    }

    println("All {} applied migrations verified successfully (0 tampered, 0 missing).", verified_count.to_string())
    return 0
}
